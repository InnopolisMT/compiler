var x : integer is 0
var y : integer is 0
var flag : boolean is true and false
var a : integer is 2
var b : integer is 3

routine main()
is
    if (true) then
        print x
        x := 5
    else
        print 0
    end

    if (3 < 5) then
        print 1
    else
        print 0
    end

    if (true and false) then
        y := 100
    else
        y := 200
    end

    while (false) loop
        y := y + 1
    end

    y := 1 + 2 * 3

    if (a + b = 5) then
        print 42
    end

    if (flag) then
        print 999
    end
end

