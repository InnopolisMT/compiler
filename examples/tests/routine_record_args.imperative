type Address is record
    var street : integer
    var number : real
    var isRussia : boolean
end

type Person is record
    var address : Address
    var age : integer
end

routine test(person : Person)
is
    person.address.street := 15
    person.age := 10
end

routine print_person(person : Person)
is
    print person.address.street
    print person.address.number
    print person.address.isRussia
    print person.age
end

routine main()
is 
    var per : Person

    per.address.street := 10
    per.address.number := 5.14
    per.address.isRussia := true
    per.age := 19
    
    test(per)

    print_person(per)
end