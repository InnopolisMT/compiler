type TMyArray is array[5] integer

routine power(base : integer, exp : integer) : integer
is
    if exp = 0 then
        return 1
    else
        if exp = 1 then
            return base
        else
            return base * power(base, exp - 1)
        end
    end
end

routine test(nums : TMyArray)
is
    for i in 1..5 loop
        nums[i] := power(nums[i], 3)
    end
end

routine main()
is 
    var x : TMyArray is [1, 2, 3, 4, 5]
    test(x)
    for i in 1..5 loop
        print x[i]
    end
end