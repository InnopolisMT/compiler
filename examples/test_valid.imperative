type Address is record
    var streetCode : integer
    var number : integer
end

type Person is record
    var age : integer
    var addr : Address
end

type IntArray is array[5] integer

routine main ()
    var arr : IntArray is [1, 2, 3, 4, 5]
    var age : integer is 300000

    for i in age .. 50 loop
        print i
    end
    
    if (age = 5) then
        print 5
    end
    
    for i in 1 .. 5 loop
        print arr[i]
    end
end

