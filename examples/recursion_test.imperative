routine fibonacci(n : integer) : integer
is
    if n <= 1 then
        return n
    else
        return fibonacci(n - 1) + fibonacci(n - 2)
    end
end

routine factorial(n : integer) : integer
is
    if n <= 1 then
        return 1
    else
        return n * factorial(n - 1)
    end
end

routine gcd(a : integer, b : integer) : integer
is
    if b = 0 then
        return a
    else
        return gcd(b, a % b)
    end
end

routine power(base : integer, exp : integer) : integer
is
    if exp = 0 then
        return 1
    else
        if exp = 1 then
            return base
        else
            return base * power(base, exp - 1)
        end
    end
end

routine main()
is
    print fibonacci(10)
    print factorial(6)
    print gcd(48, 18)
    print power(2, 10)
end

