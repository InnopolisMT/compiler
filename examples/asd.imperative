var x : integer is 0
var y : integer is 0

type TMyArray is array[5] integer

type Address is record
    var street : integer
    var number : real
    var isRussia : boolean
end

type Person is record
    var address : Address
    var age : integer
end

routine RecordTest()
is
    var myrecord : Person
    myrecord.address.street := 10
    myrecord.address.number := 5.14
    myrecord.address.isRussia := true
    myrecord.age := 19
    print myrecord.address.street
    print myrecord.address.number
    print myrecord.address.isRussia
    print myrecord.age
    print 10 + 5
end

routine test(a : integer, b : integer): real
is
    print a
    print b
    return a / b
end

routine factorial(n : integer) : integer
is
    if n <= 1 then
        return 1
    else
        return n * factorial(n - 1)
    end
end

routine main()
is
    var arr : TMyArray is [1, 2, 3, 4, 5]
    arr[3] := 15
    for i in 1..5 loop
        print arr[i]
    end

    if (true) then
        print x
        x := 5
    else
        print 5
    end

    if (3 < 5) then
        print 1
    else
        print 0
    end

    if (true and false) then
        y := 100
    else
        y := 200
    end
    print y
    print test(100, y)
end

